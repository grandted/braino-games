# Server-local deploy settings. Copy to .env on the host that runs the
# container; .env is gitignored, so a deploy pull can never overwrite it.
#
#   cp .env.example .env

# Interface the published port binds to.
#   127.0.0.1  — a reverse proxy on this same machine is the only way in
#   0.0.0.0    — reachable from the network, for a proxy on another machine
BRAINO_BIND=127.0.0.1

# Host port. The container always listens on 8787 internally.
BRAINO_PORT=8787

# Whether to believe x-forwarded-for.
#
# "1" when a reverse proxy fronts this and rewrites the header. The rate
# limiter keys on client address, so with a proxy in front and this left at
# "0" every player arrives as the proxy's IP and shares one bucket — one
# busy player would throttle everybody.
#
# "0" when clients reach the container directly. Anything that can reach the
# published port without passing the proxy can set the header itself and walk
# past the rate limit, so if this is "1", firewall the port to the proxy.
BRAINO_TRUST_PROXY=0
